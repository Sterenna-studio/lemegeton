# Le dépôt ne versionne que les formats texte (scripts, docs, rapports) :
# GLB, .blend, OBJ, images, vidéos et sauvegardes restent dans la copie de
# travail locale, comme dans minitel-musee (alors lemegeton-minitel) avant la séparation.
/**
!/**/
!/**/*.md
!/**/*.txt
!/**/*.py
!/**/*.json
!/**/*.csv
!/**/*.html
!/**/*.bat
!/**/*.ps1
!/.gitignore
!/.gitattributes

# Exports de conversation et sauvegardes : jamais versionnés.
/ChatGPT-*.md
/09_SAUVEGARDES/
**/__pycache__/
*.log

# Import WIP explicitement demandé (package historique à préserver dans Git).
!/09_SAUVEGARDES/
!/09_SAUVEGARDES/INTAKE_LEMEGETON_WIP_2026-10-13/
!/09_SAUVEGARDES/INTAKE_LEMEGETON_WIP_2026-10-13/**

# Public Lemegeton gallery: only curated, optimized derivatives are included.
!/gallery/
!/gallery/index.html
!/gallery/app.js
!/gallery/styles.css
!/gallery/README.md
!/gallery/.htaccess
!/gallery/assets/
!/gallery/assets/*.webp
!/tools/check-gallery.mjs
!/gallery/eyes/
!/gallery/eyes/*.html
!/gallery/eyes/*.css
!/gallery/eyes/*.js
!/gallery/eyes/vendor/
!/gallery/eyes/vendor/*.js
!/tools/build-eyes.mjs
!/tools/eyes/
!/tools/eyes/*.js
!/.github/workflows/deploy-gallery.yml
