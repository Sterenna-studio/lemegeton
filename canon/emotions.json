  "source_implementation": {
    "library": "web-eye-animation",
    "license": "MIT, CyberAgentAILab",
    "reference_copy": "nitro-clicker/js/vendor/web-eye-animation.js (gelée le 2026-07-06)",
    "api": "window.eyes.emotion(id), window.eyes.move(x, y), window.eyes.target(x, y, ms)"
  },
  "default": "joy",
  "idle": "sleepy",
  "references": {
